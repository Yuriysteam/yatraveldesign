{
  "$schema": "internal://travel-design/codex-skill-pack/v1",
  "schemaVersion": 1,
  "kind": "codex-skill-pack",
  "package": "travel-figma-codex",
  "version": "0.8.1",
  "classification": "internal",
  "supportedPlatforms": ["darwin"],
  "requiresExplicitUserInstallRequest": true,
  "install": {
    "strategy": "bootstrap-managed-symlink",
    "entrypoint": "bootstrap.sh",
    "args": [],
    "defaultInstallRoot": "${CODEX_HOME}/team-packs/travel-figma-codex/${version}",
    "target": "${CODEX_HOME}/skills",
    "receipt": "${CODEX_HOME}/skills/.travel-figma-codex.receipt",
    "idempotent": true,
    "onConflict": "abort",
    "overwriteExisting": false,
    "networkRequired": false
  },
  "verify": {
    "entrypoint": "doctor.sh",
    "packArgs": ["--pack-only"],
    "installedArgs": ["--installed"]
  },
  "uninstall": {
    "entrypoint": "uninstall.sh",
    "dryRunArgs": [],
    "applyArgs": ["--apply"]
  },
  "integrity": {
    "algorithm": "sha256",
    "manifest": "MANIFEST.sha256",
    "rejectUnsafeArchivePaths": true,
    "rejectPackageSymlinks": true
  },
  "permissions": {
    "writes": ["${CODEX_HOME}/team-packs/travel-figma-codex", "${CODEX_HOME}/skills"],
    "deletes": [],
    "network": false,
    "secrets": false,
    "hostApprovalMayBeRequired": true
  },
  "skills": [
    {"name": "figma-workflow-router", "version": "0.4.0", "path": "skills/figma-workflow-router", "required": true},
    {"name": "figma-design-machine", "version": "0.4.0", "path": "skills/figma-design-machine", "required": true},
    {"name": "figma-spec-builder", "version": "0.7.0", "path": "skills/figma-spec-builder", "required": true},
    {"name": "travel-figma-design-system", "version": "0.2.0", "path": "skills/travel-figma-design-system", "required": true},
    {"name": "yandex-travel-ux-writing", "version": "1.1.3", "path": "skills/yandex-travel-ux-writing", "required": true},
    {"name": "html-to-figma-spec", "version": "0.3.0", "path": "skills/html-to-figma-spec", "required": true},
    {"name": "figma-to-baseai", "version": "1.3.0", "path": "skills/figma-to-baseai", "required": true}
  ],
  "runtimes": [
    {"name": "BaseAI", "version": "1.0.0-full", "package": "travel-baseai-runtime", "required": false}
  ],
  "prerequisites": [
    {"name": "Codex Desktop", "blocking": true},
    {"name": "figma:figma-use", "blocking": false, "readiness": true},
    {"name": "figma:figma-generate-design", "blocking": false, "readiness": true},
    {"name": "figma:figma-design-to-code", "blocking": false, "readiness": true},
    {"name": "Playwright or Codex browser/computer-use", "blocking": false, "readiness": true},
    {"name": "Figma file and library access", "blocking": false, "readiness": true}
  ],
  "postInstall": {
    "newTurnRequired": true,
    "restartFallback": true,
    "smokeTests": "SMOKE-TESTS.md"
  },
  "docs": {
    "readme": "README.md",
    "agentInstall": "CODEX_INSTALL.md",
    "contributing": "CONTRIBUTING.md"
  }
}
